#!/usr/bin/env python3
# Task Management portable CachyOS launcher.
# Uses only Python standard library; no install, root, pip, service, or daemon.
import argparse, json, os, pathlib, secrets, threading, webbrowser
from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler
from urllib.parse import urlparse

ROOT=pathlib.Path(__file__).resolve().parent
WEB=ROOT
TOKEN=secrets.token_urlsafe(32)
WORKSPACE=None

def safe(root,parts):
    p=root
    for x in parts:
        if not isinstance(x,str) or not x or x in ('.','..') or '/' in x or '\\' in x: raise ValueError('unsafe path component')
        p=p/x
    p=p.resolve()
    if root.resolve()!=p and root.resolve() not in p.parents: raise ValueError('path escaped workspace')
    return p

class Handler(SimpleHTTPRequestHandler):
    def translate_path(self,path):
        rel=urlparse(path).path.lstrip('/') or 'index.html'
        return str((WEB/rel).resolve())
    def _json(self,code,obj):
        data=json.dumps(obj).encode();self.send_response(code);self.send_header('Content-Type','application/json');self.send_header('Content-Length',str(len(data)));self.end_headers();self.wfile.write(data)
    def do_GET(self):
        if self.path=='/__tm_bridge/status': return self._json(200,{'ok':True,'mode':'portable-bridge','workspace':str(WORKSPACE) if WORKSPACE else None})
        return super().do_GET()
    def do_POST(self):
        if self.headers.get('X-TM-Token')!=TOKEN:return self._json(403,{'error':'forbidden'})
        try:
            n=int(self.headers.get('Content-Length','0')); body=json.loads(self.rfile.read(n) or b'{}')
            if self.path=='/__tm_bridge/select':
                raw=body.get('path','').strip(); p=pathlib.Path(raw).expanduser().resolve()
                if not p.is_dir(): raise ValueError('workspace directory does not exist')
                test=p/('.tm-write-'+secrets.token_hex(8));test.write_text('probe');test.unlink()
                global WORKSPACE;WORKSPACE=p
                return self._json(200,{'ok':True,'workspace':str(p)})
            if not WORKSPACE: raise ValueError('workspace not selected')
            parts=body.get('path',[])
            p=safe(WORKSPACE,parts)
            if self.path=='/__tm_bridge/mkdir':p.mkdir(parents=True,exist_ok=True);return self._json(200,{'ok':True})
            if self.path=='/__tm_bridge/list':
                if not p.is_dir():raise ValueError('not a directory')
                return self._json(200,{'items':[{'name':x.name,'kind':'directory' if x.is_dir() else 'file'} for x in sorted(p.iterdir())]})
            if self.path=='/__tm_bridge/read':return self._json(200,{'text':p.read_text(encoding='utf-8')})
            if self.path=='/__tm_bridge/create':
                p.parent.mkdir(parents=True,exist_ok=True)
                fd=os.open(p,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
                with os.fdopen(fd,'w',encoding='utf-8') as f:f.write(body.get('text',''));f.flush();os.fsync(f.fileno())
                return self._json(201,{'ok':True})
            return self._json(404,{'error':'unknown operation'})
        except FileExistsError:return self._json(409,{'error':'record already exists'})
        except Exception as e:return self._json(400,{'error':str(e)})
    def log_message(self,fmt,*args): pass

def main():
    ap=argparse.ArgumentParser();ap.add_argument('--workspace');ap.add_argument('--no-browser',action='store_true');args=ap.parse_args()
    global WORKSPACE
    if args.workspace:
        p=pathlib.Path(args.workspace).expanduser().resolve()
        if not p.is_dir():raise SystemExit('Workspace does not exist: '+str(p))
        WORKSPACE=p
    server=ThreadingHTTPServer(('127.0.0.1',0),Handler);port=server.server_port
    url=f'http://127.0.0.1:{port}/index.html#tm-token={TOKEN}'
    print('Task Management portable launcher');print('Workspace:',WORKSPACE or 'select in application');print('URL:',url)
    if not args.no_browser:threading.Timer(.4,lambda:webbrowser.open(url)).start()
    try:server.serve_forever()
    except KeyboardInterrupt:pass
if __name__=='__main__':main()
